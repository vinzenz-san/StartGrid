{
  "manifest_version": 3,
  "name": "StartGrid - A New Tab",
  "description": "Customizable new tab page with widgets",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://bing.npanuhin.me/*",
    "https://*.nasa.gov/*",
    "https://*.unsplash.com/*",
    "https://*.bing.com/*"
  ]
}
